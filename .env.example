# Copy to `.env` locally (never commit `.env`).

# Gemini: set only on the server — Supabase Dashboard → Edge Functions → Secrets (or `supabase secrets set`):
#   GEMINI_API_KEY=...
# Optional: GEMINI_MODEL=gemini-2.5-flash

# Supabase — must live in `.env` at project root (same folder as package.json).
# No spaces around `=`. Restart `npm run dev` after any change.
# Browser client: anon key only — never put service_role here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push — generate offline: `npx web-push generate-vapid-keys`
# Browser (Vercel): public key only — must match Edge Function secret WEB_PUSH_VAPID_PUBLIC_KEY byte-for-byte.
# Prefer VITE_WEB_PUSH_VAPID_PUBLIC_KEY; VITE_VAPID_PUBLIC_KEY is read as a fallback if the first is unset.
# VITE_WEB_PUSH_VAPID_PUBLIC_KEY=BkL...publicKeyBase64...
# Supabase secrets for reminder-cron (same pair as above): WEB_PUSH_VAPID_PUBLIC_KEY + WEB_PUSH_VAPID_PRIVATE_KEY

# gemini-proxy CORS lockdown (Edge Function secret — production origins comma-separated):
#   supabase secrets set ALLOWED_ORIGINS="https://your-prod-host,http://localhost:5173"
# Auth → leaked password protection (HaveIBeenPwned): enable in Dashboard
#   Authentication → Providers → Email → Password strength (Pro plan+).
#   Management API: PATCH /v1/projects/{ref}/config/auth { "password_hibp_enabled": true }

# Local legacy auth only (never use in production builds). Set passwords in `.env`, not in source.
# VITE_USE_LEGACY_AUTH=true
# VITE_DEMO_THERAPIST_A_PASSWORD=
# VITE_DEMO_THERAPIST_B_PASSWORD=
# VITE_DEMO_SEED_PATIENT_PORTAL_PASSWORD=
